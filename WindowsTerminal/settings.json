{
  "$help": "https://aka.ms/terminal-documentation",
  "$schema": "https://aka.ms/terminal-profiles-schema",
  "actions": [
    {
      "command": "closeTab",
      "id": "User.CloseTab",
      "name": "Close tab"
    },
    {
      "command": "sendInput",
      "input": "\u001b[13;2u",
      "id": "User.SendShiftEnter",
      "name": "Send Shift+Enter"
    }
  ],
  "copyFormatting": "none",
  "copyOnSelect": false,
  "defaultProfile": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
  "keybindings": [
    {
      "keys": "ctrl+tab",
      "id": "Terminal.NextTab"
    },
    {
      "keys": "ctrl+shift+tab",
      "id": "Terminal.PrevTab"
    },
    {
      "keys": "ctrl+shift+t",
      "id": "Terminal.OpenNewTab"
    },
    {
      "keys": "ctrl+shift+d",
      "id": "Terminal.DuplicateTab"
    },
    {
      "keys": "alt+shift+d",
      "id": "Terminal.DuplicatePaneAuto"
    },
    {
      "keys": "ctrl+shift+w",
      "id": "User.CloseTab"
    },
    {
      "keys": "ctrl+alt+w",
      "id": "Terminal.ClosePane"
    },
    {
      "keys": "ctrl+shift+f",
      "id": "Terminal.FindText"
    },
    {
      "keys": "ctrl+shift+a",
      "id": "Terminal.SelectAll"
    },
    {
      "keys": "ctrl+shift+c",
      "id": "Terminal.CopyToClipboard"
    },
    {
      "keys": "ctrl+shift+v",
      "id": "Terminal.PasteFromClipboard"
    },
    {
      "keys": "ctrl+shift+up",
      "id": "Terminal.ScrollUp"
    },
    {
      "keys": "ctrl+shift+down",
      "id": "Terminal.ScrollDown"
    },
    {
      "keys": "ctrl+shift+space",
      "id": "Terminal.OpenNewTabDropdown"
    },
    {
      "keys": "shift+enter",
      "id": "User.SendShiftEnter"
    }
  ],
  "newTabMenu": [
    {
      "type": "remainingProfiles"
    }
  ],
  "profiles": {
    "defaults": {
      "colorScheme": "Catppuccin Mocha",
      "experimental.retroTerminalEffect": false,
      "font": {
        "face": "JetBrainsMono Nerd Font",
        "size": 11
      },
      "intenseTextStyle": "all",
      "opacity": 90,
      "padding": "8",
      "useAcrylic": true
    },
    "list": [
